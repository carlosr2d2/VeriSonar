{
  "id": null,
  "uid": "verisonar-ops",
  "title": "VeriSonar — operaciones",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Análisis completados",
      "id": 1,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(verisonar_analyses_total{status=\"completed\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Análisis fallidos",
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(verisonar_analyses_total{status=\"failed\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Duración de análisis",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(verisonar_analysis_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Índice de riesgo observado",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "rate(verisonar_deception_index_sum[5m]) / clamp_min(rate(verisonar_deception_index_count[5m]), 0.001)",
          "legendFormat": "media",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Streams WebSocket",
      "id": 5,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "verisonar_active_streams",
          "refId": "A"
        }
      ]
    }
  ]
}
