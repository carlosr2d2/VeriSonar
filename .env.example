# VeriSonar — configuración de entorno
# Copiar a .env y ajustar valores. Nunca versionar secretos reales.

APP_NAME=VeriSonar
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=cambiar-esta-clave-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Idioma por defecto (es-LATAM). En fases posteriores se habilita en.
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=es,en
PROCESSING_MODE=offline

# PostgreSQL
POSTGRES_USER=verisonar
POSTGRES_PASSWORD=verisonar
POSTGRES_DB=verisonar
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://verisonar:verisonar@postgres:5432/verisonar

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Almacenamiento local (offline)
UPLOAD_DIR=/data/uploads
REPORT_DIR=/data/reports
MODEL_DIR=/data/models

# STT offline
ENABLE_VOSK=true
ENABLE_WHISPER=true
# large-v3: mejor español y telefonía 8 kHz. distil-large-v3 es solo inglés.
WHISPER_MODEL_SIZE=large-v3
VOSK_MODEL_NAME=vosk-model-small-es-0.42

# NLP
ENABLE_TRANSFORMERS=false
NLP_MODEL_PATH=/data/models/nlp
ENABLE_PRAAT=true

# API pública (navegador)
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://backend:8000

# Frontend
FRONTEND_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Observabilidad
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO

# Notificaciones push (fase móvil)
FCM_SERVER_KEY=
PUSH_ENABLED=false

# Usuario semilla
BOOTSTRAP_ADMIN_EMAIL=admin@verisonar.local
BOOTSTRAP_ADMIN_PASSWORD=VeriSonar.Admin1
BOOTSTRAP_ADMIN_NAME=Administrador VeriSonar
